package main

native fn print_any(arg: any): void

fn main(): void {
    print_any("casting in kirin")

    x := -200.75

    print_any(square(x))

    y := x as i64

    print_any(y)

    for i := -10; i <= 10; i = i + 1 {
        result : f64 = square(i)

        print_any(result)
    }
}

fn square(val: f64): f64 {
    return val * val
}