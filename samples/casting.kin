package main

native fn print_any(arg: any): void

fn main(): void {
    print_any("casting in kirin")

    x : f64 = 200.75

    print_any(square(x))

    y : i64 = x

    print_any(y)

    for i : i64 = 1; i <= 100; i = i + 1 {
        result : f64 = square(i)

        print_any(result)
    }
}

fn square(val: f64): f64 {
    return val * val
}