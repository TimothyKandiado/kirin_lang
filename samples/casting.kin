package main

native fn print_any(arg: any): void

fn main(): void {
    print_any("casting in kirin" as any)

    x : f64 = 200.75

    print_any(square(x) as f64 as any)

    y : i64 = x as i64

    print_any(y as any)

    for i : i64 = 1; i <= 100; i = i + 1 {
        result : f64 = square(i as f64)

        print_any(result as any)
    }
}

fn square(val: f64): f64 {
    return val * val
}